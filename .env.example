# Cópia para .env.local / adicionar nas env vars do Vercel
# (Project Settings > Environment Variables)

# Chave do serviço do Supabase (PERMITE ESCREVER — nunca colocar no frontend)
SUPABASE_URL=https://jssscxlnzytmwzbabvhu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque_a_service_role_key_aqui

# Chave secreta do Turnstile (criar em https://dash.cloudflare.com > Turnstile)
# Sem ela a verificação de captcha fica desabilitada na API.
TURNSTILE_SECRET_KEY=coloque_a_secret_key_aqui

# Webhook do Discord para notificar novas candidaturas de criadores
# (YouTuber/Streamer). Opcional: sem ela nada é enviado.
# Criar em https://discord.com/developers > Applications > seu app > Bot > Webhooks
DISCORD_WEBHOOK_URL=coloque_a_url_do_webhook_aqui